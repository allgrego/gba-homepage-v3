# Copy to .env.local for local development. In production set these in Vercel > Project > Settings > Environment Variables.
# Setup guide: docs/quote-form-setup.md

# --- Switches (apply after a redeploy on Vercel) ---
# Kill switch for the whole quote form + Server Action. On unless set to false/0/no/off.
# While off, the form is replaced by a "write to us by email" notice (using NEXT_PUBLIC_CONTACT_EMAIL).
QUOTE_FORM_ENABLED=true
# Google Sheet logging is optional. Only runs when true; the email keeps working either way.
QUOTE_SHEET_ENABLED=false

# Mailtrap > Email Sending (NOT Email Sandbox). API token with access to the verified domain.
MAILTRAP_API_TOKEN=
# Sender: any address on the domain verified in Mailtrap.
MAILTRAP_FROM_EMAIL=web@gbalogistic.com
# Inbox that receives the quote requests from the form (server only, never shown on the site).
QUOTE_TO_EMAIL=sales@gbalogistic.com

# Public contact address shown on the site (top bar, contact section, mailto links). Independent of QUOTE_TO_EMAIL.
# Inlined at build time, so it is public. Defaults to sales@gbalogistic.com when unset or invalid.
NEXT_PUBLIC_CONTACT_EMAIL=sales@gbalogistic.com

# Only needed when QUOTE_SHEET_ENABLED=true. Apps Script web app URL (ends in /exec) and the same secret saved in the script's Script Properties as SECRET.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
